{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.web.tsbuildinfo",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // The production program: application source and the Vite config that builds
  // it, and nothing that only exists to test it. Tests, their fixtures and the
  // Tailwind config the contrast test reads live in tsconfig.test.json, so a
  // deployment build never needs Vitest's types to be installed.
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test", "dist"],
  "references": [{ "path": "../../packages/shared" }]
}
