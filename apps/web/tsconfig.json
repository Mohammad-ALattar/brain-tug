{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.web.tsbuildinfo",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    // The contrast test reads the palette straight out of the Tailwind config,
    // so the config is part of the typed program rather than just a build input.
    "tailwind.config.ts"
  ],
  "references": [{ "path": "../../packages/shared" }]
}
