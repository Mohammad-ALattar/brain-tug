{
  "name": "math-tug-of-war",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time classroom mathematics tug-of-war competition",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently --names \"shared,server,web\" --prefix-colors \"gray,cyan,magenta\" --kill-others-on-fail \"npm:dev:shared\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:shared": "npm run dev --workspace=@mtow/shared",
    "dev:server": "npm run dev --workspace=@mtow/server",
    "dev:web": "npm run dev --workspace=@mtow/web",
    "build:shared": "npm run build --workspace=@mtow/shared",
    "build": "npm run build:shared && npm run build --workspace=@mtow/server && npm run build --workspace=@mtow/web",
    "build:web": "npm run build:shared && npm run build --workspace=@mtow/web",
    "build:server": "npm run build:shared && npm run build --workspace=@mtow/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:load": "vitest run --project=server load",
    "e2e": "npm run build && playwright test",
    "e2e:ui": "playwright test --ui",
    "start": "node scripts/serve-built.mjs",
    "start:server": "node apps/server/dist/index.js",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.49.1",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
