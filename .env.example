# --- Server ---
# Port the authoritative game server listens on.
PORT=3001
# Comma-separated list of origins allowed to open a socket. Use * only in development.
CORS_ORIGIN=http://localhost:5173
# Node environment: development | production | test
NODE_ENV=development
# Log level: debug | info | warn | error
LOG_LEVEL=info
# How long an abandoned game session is kept before it is reaped, in milliseconds.
SESSION_TTL_MS=7200000
# Directory of built client assets for the server to serve. Set this to run the
# whole game on one origin, which removes CORS entirely. Leave blank in
# development, where Vite serves the client on its own port.
# CLIENT_DIST=apps/web/dist

# --- Web (Vite: only VITE_* variables are exposed to the browser) ---
# Base URL of the game server socket. Leave blank to use the page origin.
VITE_SERVER_URL=http://localhost:3001
