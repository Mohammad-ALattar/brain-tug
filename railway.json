{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace=@braintug/server",
    "watchPatterns": [
      "/apps/server/**",
      "/packages/shared/**",
      "/package.json",
      "/package-lock.json",
      "/.npmrc",
      "/railway.toml",
      "/railway.json",
      "/railpack.json",
      "/Procfile",
      "/tsconfig.json",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/server/dist/index.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
